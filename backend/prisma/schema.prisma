generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Prediction {
  id          String   @id @default(cuid())
  label       String
  confidence  Float
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("predictions")
}