generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prediction {
  id          String   @id @default(cuid())
  label       String
  confidence  Float
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("predictions")
}

model tps_master {
  id            String  @id
  nama_desa     String?
  kecamatan     String?
  kabupaten     String?
  area_type     String?
  lat           Decimal?
  lon           Decimal?
  kapasitas_ton Decimal?
}