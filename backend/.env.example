# Server
PORT=3000
NODE_ENV=production

# Database — gunakan connection string dari provider (Supabase / Neon / Railway)
DATABASE_URL=postgresql://user:password@host:5432/trash_classifier?schema=public

# CORS — isi domain frontend (Vercel)
CORS_ORIGIN=https://your-frontend.vercel.app

# AI Service — URL server Python (FastAPI / Flask)
USE_MOCK_AI=false
AI_SERVICE_URL=https://your-ai-service.com/predict/
AI_API_KEY=
AI_TIMEOUT=30000

# Upload
MAX_FILE_SIZE=5242880
